DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=econ
POSTGRES_USER=econ
POSTGRES_PASSWORD=econ
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

ECON_LLM_BASE_URL=http://127.0.0.1:11434
ECON_LLM_MODEL=hermes
ECON_CONFIDENCE_THRESHOLD=0.90
ECON_EXECUTION_TIMEOUT=30

# local = subprocess on this process; host_agent = HTTP to the Mac/Linux host daemon
ECON_EXECUTION_MODE=local
ECON_HOST_AGENT_URL=http://127.0.0.1:8765
ECON_HOST_AGENT_TOKEN=change-me-host-agent-token
ECON_HOST_AGENT_BIND=127.0.0.1
ECON_HOST_AGENT_PORT=8765
